DATABASE_URL="postgresql://supervision:supervision@localhost:5434/supervision?schema=public"
JWT_SECRET="change-moi"
PORT=3002
CORS_ORIGIN="http://localhost:5175"
# Fréquence des contrôles (secondes)
POLL_INTERVAL_SECONDS=30
# Nombre d'échecs consécutifs avant de déclarer un équipement DOWN (anti-faux positifs)
FAILURES_BEFORE_DOWN=2
# Conservation de l'historique des mesures (jours)
RETENTION_DAYS=7
# Webhook Discord, Slack ou Teams (facultatif)
ALERT_WEBHOOK_URL=""
